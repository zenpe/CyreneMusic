<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/notification_card_bg"
    android:padding="8dp">

    <!-- 专辑封面 -->
    <ImageView
        android:id="@+id/notification_album_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:background="@drawable/notification_cover_bg"
        android:clipToOutline="true"
        android:src="@drawable/ic_notification" />

    <!-- 右侧控制按钮区域 -->
    <LinearLayout
        android:id="@+id/notification_controls"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notification_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_prev"
            android:contentDescription="上一首" />

        <ImageButton
            android:id="@+id/notification_btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notification_play_btn_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_play"
            android:contentDescription="播放/暂停" />

        <ImageButton
            android:id="@+id/notification_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_next"
            android:contentDescription="下一首" />
    </LinearLayout>

    <!-- 中间歌曲信息与进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/notification_album_art"
        android:layout_toStartOf="@id/notification_controls"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cyrene Music"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="未知歌手"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/notification_progress_bar" />
    </LinearLayout>

</RelativeLayout>
